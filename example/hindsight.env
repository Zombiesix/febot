# Hindsight 模型配置模板 —— `yarn setup` 会生成 scripts/hindsight.env，填入你自己的 key（生成物已被 gitignore）
#
# ==== LLM 事实抽取 ====
# 火山方舟 Agent Plan Key（ark- 前缀）。⚠️ Plan Key 有路径隔离：
#   只在 /api/plan/v1 下有效；/api/v3 一律 401；裸 /api/plan 404；无 /models 列表端点。
# 获取：火山方舟控制台 → API Key 管理（需订阅 Agent Plan）
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v1
HINDSIGHT_API_LLM_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HINDSIGHT_API_LLM_MODEL=deepseek-v4.1-flash
#
# ==== Embedding 向量生成 ====
# 为什么不用火山方舟 embedding（三次尝试均失败，2026-10-08 实测）：
#   ① doubao-embedding-large-text-250515 — 官方即将下线
#   ② doubao-embedding-vision-251215   — 多模态专用 API（/embeddings/multimodal），
#      请求需对象数组 input、响应 data 为 dict 而非 list，与 LiteLLM/OpenAI 标准格式不兼容
#   ③ Plan Key 本身就不能调 embeddings（/api/plan/v1/embeddings 404）
# → 用硅基流动 SiliconFlow（免费额度足够，OpenAI 标准兼容，国内直连）
# 获取：https://cloud.siliconflow.cn 注册 → API 密钥
HINDSIGHT_API_EMBEDDINGS_PROVIDER=litellm
HINDSIGHT_API_EMBEDDINGS_LITELLM_API_BASE=https://api.siliconflow.cn/v1
HINDSIGHT_API_EMBEDDINGS_LITELLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HINDSIGHT_API_EMBEDDINGS_LITELLM_MODEL=BAAI/bge-m3
HINDSIGHT_API_EMBEDDINGS_LITELLM_DIMENSIONS=1024
#
# ==== Reranker ====
# rrf = Reciprocal Rank Fusion，纯排序算法，无需外部模型/密钥。
# ⚠️ "none" 不是合法值（启动报 ValueError）；合法值还有 local/tei/cohere/siliconflow/flashrank/litellm 等。
HINDSIGHT_API_RERANKER_PROVIDER=rrf
