{
  "name": "febot",
  "version": "1.0.0",
  "private": true,
  "description": "febot：前端研发自动化工作区",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/requirement.test.mjs",
    "setup": "node scripts/ensure-config.mjs && yarn --cwd code-indexer && yarn --cwd xiaoqian-manager && yarn --cwd swagger-mcp-server && yarn --cwd desktop",
    "dev": "node scripts/dev.mjs",
    "xiaoqian": "yarn --cwd xiaoqian-manager dev",
    "runner": "yarn --cwd xiaoqian-manager runner",
    "desktop:install": "yarn --cwd desktop",
    "desktop:dev": "yarn --cwd desktop dev",
    "desktop:build": "yarn --cwd desktop build",
    "desktop:dist": "yarn --cwd desktop dist",
    "recon": "node scripts/recon.mjs",
    "locate": "node scripts/locate.mjs",
    "advance": "node scripts/advance.mjs",
    "index:query": "node scripts/index-query.mjs",
    "start:list": "node scripts/start-commands.mjs",
    "feed": "node scripts/feed.mjs",
    "assistant:probe": "node scripts/assistant-probe.mjs",
    "assistant:memo": "node scripts/assistant-memo.mjs",
    "assistant:map": "node scripts/assistant-map.mjs"
  }
}
